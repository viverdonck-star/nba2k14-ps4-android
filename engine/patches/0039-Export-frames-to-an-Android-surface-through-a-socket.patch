           width{width_}, height{height_}, format{format_}, hdr_encoded{hdr_encoded_} {}
 };
 
+
+namespace {
+// One message per connection, then one u32 slot per frame.
+struct FrameHeader {
+    u32 magic;
+    u32 width;
+    u32 height;
+    u32 stride;
+    u32 format;
+    u32 slots;
+};
+constexpr u32 kFrameMagic = 0x3146424e;
+constexpr u32 kFrameSlots = 3;
+
+class FrameExport {
+public:
+    static FrameExport& Get() {
+        static FrameExport instance;
+        return instance;
+    }
+
+    bool Enabled() const {
+        return path != nullptr;
+    }
+
+    ScreenshotReadback& Buffer(const Instance& instance, Scheduler& scheduler, u32 width,
+                               u32 height, vk::Format format) {
+        if (buffers.empty()) {
+            for (u32 i = 0; i < kFrameSlots; ++i) {
+                buffers.emplace_back(std::make_unique<ScreenshotReadback>(
+                    instance, scheduler, ScreenshotKind::GameOnly,
+                    std::vector<std::filesystem::path>{}, width, height, format, false));
+            }
+        }
+        return *buffers[slot];
+    }
+
+    void Publish() {
+        const auto& frame = *buffers[slot];
+        const u32 stride = frame.width * 4;
+        const u64 frame_size = u64(stride) * frame.height;
+        if (socket_fd < 0 && !Connect(frame, stride, frame_size)) {
+            slot = (slot + 1) % kFrameSlots;
+            return;
+        }
+        std::memcpy(shared + frame_size * slot, frame.buffer.mapped_data.data(), frame_size);
+        if (send(socket_fd, &slot, sizeof(slot), MSG_DONTWAIT | MSG_NOSIGNAL) < 0 &&
+            errno != EAGAIN) {
+            LOG_ERROR(Render_Vulkan, "NBA2K14 frame socket closed");
+            close(socket_fd);
+            socket_fd = -1;
+        }
+        slot = (slot + 1) % kFrameSlots;
+    }
+
+private:
+    FrameExport() : path{std::getenv("NBA2K14_FRAME_SOCKET")} {}
+
+    bool Connect(const ScreenshotReadback& frame, u32 stride, u64 frame_size) {
+        const int fd = socket(AF_UNIX, SOCK_STREAM, 0);
+        sockaddr_un address{};
+        address.sun_family = AF_UNIX;
+        std::strncpy(address.sun_path, path, sizeof(address.sun_path) - 1);
+        if (fd < 0 || connect(fd, reinterpret_cast<sockaddr*>(&address), sizeof(address)) != 0) {
+            if (fd >= 0) {
+                close(fd);
+            }
+            return false;
+        }
+        if (!shared) {
+            shared_fd = memfd_create("nba2k14-frames", 0);
+            if (shared_fd < 0 || ftruncate(shared_fd, off_t(frame_size * kFrameSlots)) != 0) {
+                close(fd);
+                return false;
+            }
+            void* memory = mmap(nullptr, frame_size * kFrameSlots, PROT_READ | PROT_WRITE,
+                                MAP_SHARED, shared_fd, 0);
+            if (memory == MAP_FAILED) {
+                close(fd);
+                return false;
+            }
+            shared = static_cast<u8*>(memory);
+        }
+        FrameHeader header = {kFrameMagic, frame.width, frame.height, stride,
+                              static_cast<u32>(frame.format), kFrameSlots};
+        iovec payload{&header, sizeof(header)};
+        alignas(cmsghdr) char control[CMSG_SPACE(sizeof(int))]{};
+        msghdr message{};
+        message.msg_iov = &payload;
+        message.msg_iovlen = 1;
+        message.msg_control = control;
+        message.msg_controllen = sizeof(control);
+        cmsghdr* item = CMSG_FIRSTHDR(&message);
+        item->cmsg_level = SOL_SOCKET;
+        item->cmsg_type = SCM_RIGHTS;
+        item->cmsg_len = CMSG_LEN(sizeof(int));
+        std::memcpy(CMSG_DATA(item), &shared_fd, sizeof(int));
+        if (sendmsg(fd, &message, MSG_NOSIGNAL) != sizeof(header)) {
+            close(fd);
+            return false;
+        }
+        socket_fd = fd;
+        LOG_INFO(Render_Vulkan, "NBA2K14 frame export connected {}x{}", frame.width, frame.height);
+        return true;
+    }
+
+    const char* path;
+    std::vector<std::unique_ptr<ScreenshotReadback>> buffers;
+    u8* shared = nullptr;
+    int shared_fd = -1;
+    int socket_fd = -1;
+    u32 slot = 0;
+};
+} // namespace

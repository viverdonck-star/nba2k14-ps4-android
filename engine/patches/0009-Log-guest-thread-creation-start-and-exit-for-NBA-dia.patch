From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: NBA2K14-offline-port <nba2k14-offline@localhost>
Date: Fri, 30 Oct 2026 21:53:34 +0100
Subject: [PATCH 09/40] Log guest thread creation start and exit for NBA
 diagnostics

---
 src/core/libraries/kernel/threads/pthread.cpp | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/core/libraries/kernel/threads/pthread.cpp b/src/core/libraries/kernel/threads/pthread.cpp
index 170337cc..81c1674a 100644
--- a/src/core/libraries/kernel/threads/pthread.cpp
+++ b/src/core/libraries/kernel/threads/pthread.cpp
@@ -1,3 +1,4 @@
+#include <unistd.h>
 // SPDX-FileCopyrightText: Copyright 2025-2026 shadPS4 Emulator Project
 // SPDX-License-Identifier: GPL-2.0-or-later
 
@@ -245,6 +246,8 @@ static void* RunThread(void* arg) {
     std::set_terminate(Common::Log::Terminate);
 #endif
 
+    LOG_INFO(Kernel_Pthread, "NBA2K14_THREAD start tid={} htid={} name={} entry={:#x}", curthread->tid.load(), static_cast<int>(gettid()),
+             curthread->name, reinterpret_cast<uintptr_t>(curthread->start_routine));
     /* Run the current thread's start routine with argument: */
     auto* const stack =
         (void*)(((size_t)curthread->attr.stackaddr_attr + curthread->attr.stacksize_attr) & (~15));
@@ -264,6 +267,7 @@ static void* RunThread(void* arg) {
     void* ret = _runOnAnotherStack(curthread->arg, (void*)curthread->start_routine, stack);
 #endif
 
+    LOG_INFO(Kernel_Pthread, "NBA2K14_THREAD exit tid={} name={}", curthread->tid.load(), curthread->name);
     /* Remove thread from tracking */
     DebugState.RemoveCurrentThreadFromGuestList();
     posix_pthread_exit(ret);
@@ -346,6 +350,9 @@ int PS4_SYSV_ABI posix_pthread_create_name_np(PthreadT* thread, const PthreadAtt
     /* Return thread pointer eariler so that new thread can use it. */
     (*thread) = new_thread;
 
+    LOG_INFO(Kernel_Pthread, "NBA2K14_THREAD create tid={} name={} entry={:#x} prio={} stack={:#x}",
+             new_thread->tid.load(), new_thread->name, reinterpret_cast<uintptr_t>(start_routine),
+             new_thread->attr.prio, new_thread->attr.stacksize_attr);
     /* Create thread */
     new_thread->native_thr = Core::NativeThread();
     int ret = new_thread->native_thr.Create(RunThread, new_thread);

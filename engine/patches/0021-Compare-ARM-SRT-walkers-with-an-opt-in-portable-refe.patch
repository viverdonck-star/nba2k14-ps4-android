diff --git a/src/shader_recompiler/ir/passes/srt_reference.h b/src/shader_recompiler/ir/passes/srt_reference.h
new file mode 100644
index 00000000..e661a330
--- /dev/null
+++ b/src/shader_recompiler/ir/passes/srt_reference.h
@@ -0,0 +1,66 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <cstdint>
+#include <span>
+#include <vector>
+
+namespace Shader::SrtReference {
+// A declarative pointer tree, independent of the ARM instruction emitter.
+struct Copy { std::uint32_t source_dw; std::uint32_t destination_dw; };
+struct Node {
+    std::uint32_t pointer_dw;
+    std::vector<Copy> copies;
+    std::vector<Node> children;
+};
+struct Program {
+    std::vector<Node> roots;
+    std::uint32_t word_count = 16;
+    std::uint64_t checks{}, compared_words{}, differences{}, unreadable_checks{}, transient{};
+    bool reported_difference{}, reported_unreadable{};
+    std::vector<std::uint32_t> expected;
+    std::vector<std::uint64_t> source_addresses;
+};
+struct ReadStatus { std::uint64_t unreadable{}; std::uint64_t first_unreadable{}; };
+
+// Read is a fault-safe callback: bool(uint64_t byte_address, uint32_t& value).
+// Invalid loads become zero, matching the native walker's recovery handler.
+template <typename Read>
+ReadStatus Execute(const Program& program, std::span<const std::uint32_t> user_data,
+                   std::span<std::uint32_t> output, Read&& read,
+                   std::span<std::uint64_t> source_addresses = {}) {
+    ReadStatus status;
+    auto load = [&](std::uint64_t address) {
+        std::uint32_t word{};
+        if (!read(address, word)) {
+            if (status.unreadable++ == 0) status.first_unreadable = address;
+            word = 0;
+        }
+        return word;
+    };
+    auto visit = [&](auto&& self, const Node& node, std::uint64_t parent, bool root) -> void {
+        std::uint32_t lo{}, hi{};
+        if (root) {
+            if (node.pointer_dw + 1 < user_data.size()) {
+                lo = user_data[node.pointer_dw];
+                hi = user_data[node.pointer_dw + 1];
+            } else {
+                ++status.unreadable;
+            }
+        } else {
+            lo = load(parent + std::uint64_t(node.pointer_dw) * 4);
+            hi = load(parent + std::uint64_t(node.pointer_dw) * 4 + 4);
+        }
+        const std::uint64_t pointer = (std::uint64_t(lo) | (std::uint64_t(hi) << 32)) & 0xffffffffffffULL;
+        // As in upstream x86: copy this level first, then recurse into child pointers.
+        for (const auto& copy : node.copies) {
+            const auto address = pointer + std::uint64_t(copy.source_dw) * 4;
+            if (copy.destination_dw < output.size()) output[copy.destination_dw] = load(address);
+            if (copy.destination_dw < source_addresses.size()) source_addresses[copy.destination_dw] = address;
+        }
+        for (const auto& child : node.children) self(self, child, pointer, false);
+    };
+    for (const auto& root : program.roots) visit(visit, root, 0, true);
+    return status;
+}
+} // namespace Shader::SrtReference

 namespace Shader {
 
+void CheckSrtReference(Info& info) {
+    auto& ref = *info.srt_reference;
+    auto read = [](u64 address, u32& word) {
+        iovec local{&word, sizeof(word)};
+        iovec remote{reinterpret_cast<void*>(address), sizeof(word)};
+        return process_vm_readv(getpid(), &local, 1, &remote, 1, 0) == sizeof(word);
+    };
+    static const bool reader_available = [&] {
+        u32 probe = 0x12345678u, result{};
+        const bool ok = read(reinterpret_cast<u64>(&probe), result) && result == probe;
+        if (!ok) LOG_ERROR(Render_Recompiler, "NBA2K14_SRT_UNAVAILABLE safe reader errno={}", errno);
+        return ok;
+    }();
+    if (!reader_available) return;
+    ref.expected.resize(ref.word_count);
+    ref.source_addresses.resize(ref.word_count);
+    auto compare = [&] {
+        std::fill(ref.expected.begin(), ref.expected.end(), 0x5a5a5a5au);
+        std::fill_n(ref.expected.begin(), NUM_USER_DATA_REGS, 0xa5a5a5a5u);
+        std::copy(info.user_data.begin(), info.user_data.end(), ref.expected.begin());
+        return SrtReference::Execute(ref, info.user_data, ref.expected, read, ref.source_addresses);
+    };
+    auto status = compare();
+    auto first_difference = [&](std::span<const u32> actual) {
+        for (u32 index = 0; index < ref.word_count; ++index) {
+            if (ref.expected[index] != actual[index]) return index;
+        }
+        return ref.word_count;
+    };
+    u32 different = first_difference(info.flattened_ud_buf);
+    u32 arm_value = different < ref.word_count ? info.flattened_ud_buf[different] : 0;
+    if (different != ref.word_count && status.unreadable == 0) {
+        // Repeat into scratch: the checker must not change the shader's actual output.
+        const u32 previous_index = different;
+        const u32 previous_expected = ref.expected[different];
+        const u64 previous_source = ref.source_addresses[different];
+        std::vector<u32> retry(ref.word_count, 0xa5a5a5a5u);
+        std::copy(info.user_data.begin(), info.user_data.end(), retry.begin());
+        info.srt_info.walker_func(info.user_data.data(), retry.data());
+        status = compare();
+        different = first_difference(retry);
+        const bool stable = different == previous_index && status.unreadable == 0 &&
+                            ref.expected[different] == previous_expected &&
+                            ref.source_addresses[different] == previous_source &&
+                            retry[different] == arm_value;
+        if (!stable) {
+            ++ref.transient;
+            different = ref.word_count;
+        }
+    }
+    ++ref.checks;
+    ref.compared_words += ref.word_count - NUM_USER_DATA_REGS;
+    if (status.unreadable) {
+        ++ref.unreadable_checks;
+        if (!ref.reported_unreadable) {
+            ref.reported_unreadable = true;
+            LOG_WARNING(Render_Recompiler,
+                        "NBA2K14_SRT_UNREADABLE shader={:#x} stage={} address={:#x} reads={} errno={}",
+                        info.pgm_hash, static_cast<u32>(info.stage), status.first_unreadable,
+                        status.unreadable, errno);
+        }
+    } else if (different != ref.word_count) {
+        ++ref.differences;
+        if (!ref.reported_difference) {
+            ref.reported_difference = true;
+            LOG_ERROR(Render_Recompiler,
+                      "NBA2K14_SRT_DIFF shader={:#x} stage={} word={} source={:#x} arm={:#x} reference={:#x} check={}",
+                      info.pgm_hash, static_cast<u32>(info.stage), different,
+                      ref.source_addresses[different], arm_value,
+                      ref.expected[different], ref.checks);
+        }
+    }
+    if (ref.checks == 1 || ref.checks % 4096 == 0) {
+        LOG_INFO(Render_Recompiler,
+                 "NBA2K14_SRT_STATS shader={:#x} stage={} checks={} words={} differences={} unreadable={} transient={}",
+                 info.pgm_hash, static_cast<u32>(info.stage), ref.checks, ref.compared_words,
+                 ref.differences, ref.unreadable_checks, ref.transient);
+    }
+}
+
 PFN_SrtWalker RegisterWalkerCode(const u8* ptr, size_t size) {
     if (!IsArm64SrtWalker(ptr, size)) {
         LOG_WARNING(Render_Recompiler,
@@ -563,6 +646,22 @@ void VisitPointer(u32 offset_dw, IR::Inst* subtree, PassInfo& pass_info,
     emitter.PopPointer();
 }
 
+SrtReference::Node BuildReferenceNode(u32 pointer_dw, IR::Inst* subtree,
+                                     PassInfo& pass_info, u32& destination_dw) {
+    SrtReference::Node node{pointer_dw};
+    const auto* uses = pass_info.GetUsesAsPointer(subtree);
+    ASSERT(uses);
+    for (const auto& [source_dw, inst] : *uses) {
+        node.copies.push_back({source_dw, destination_dw++});
+    }
+    for (const auto& [source_dw, inst] : *uses) {
+        if (pass_info.GetUsesAsPointer(inst)) {
+            node.children.push_back(BuildReferenceNode(source_dw, inst, pass_info, destination_dw));
+        }
+    }
+    return node;
+}
+
 void GenerateSrtProgram(Info& info, PassInfo& pass_info) {
     if (pass_info.srt_roots.empty()) {
         return;
@@ -581,6 +680,20 @@ void GenerateSrtProgram(Info& info, PassInfo& pass_info) {
     ASSERT(info.srt_info.walker_func != nullptr);
     info.srt_info.walker_func_size = emitter.Size();
     info.srt_info.flattened_bufsize_dw = pass_info.dst_off_dw;
+    const char* check = std::getenv("NBA2K14_SRT_CHECK");
+    if (check && std::strcmp(check, "1") == 0) {
+        auto reference = std::make_shared<SrtReference::Program>();
+        for (const auto& [sgpr, root] : pass_info.srt_roots) {
+            reference->roots.push_back(BuildReferenceNode(static_cast<u32>(sgpr), root, pass_info,
+                                                         reference->word_count));
+        }
+        ASSERT(reference->word_count == pass_info.dst_off_dw);
+        LOG_INFO(Render_Recompiler, "NBA2K14_SRT_BEGIN shader={:#x} stage={} roots={} words={}",
+                 info.pgm_hash, static_cast<u32>(info.stage), reference->roots.size(),
+                 reference->word_count - NUM_USER_DATA_REGS);
+        info.srt_reference = std::move(reference);
+    }
+
 }
 
 } // namespace

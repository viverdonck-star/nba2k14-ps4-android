From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: NBA2K14-offline-port <nba2k14-offline@localhost>
Date: Fri, 30 Oct 2026 22:45:46 +0100
Subject: [PATCH 17/40] Add optional NBA texture target and descriptor
 alignment diagnostics

---
 src/video_core/renderer_vulkan/vk_instance.cpp |  4 +++-
 src/video_core/texture_cache/texture_cache.cpp | 13 +++++++++++++
 src/video_core/texture_cache/tile_manager.cpp  | 16 ++++++++++++++++
 3 files changed, 32 insertions(+), 1 deletion(-)

diff --git a/src/video_core/renderer_vulkan/vk_instance.cpp b/src/video_core/renderer_vulkan/vk_instance.cpp
index a0977668..fa7be561 100644
--- a/src/video_core/renderer_vulkan/vk_instance.cpp
+++ b/src/video_core/renderer_vulkan/vk_instance.cpp
@@ -224,7 +224,9 @@ bool Instance::CreateDevice() {
     vk12_props = properties_chain.get<vk::PhysicalDeviceVulkan12Properties>();
     vk13_props = properties_chain.get<vk::PhysicalDeviceVulkan13Properties>();
     push_descriptor_props = properties_chain.get<vk::PhysicalDevicePushDescriptorPropertiesKHR>();
-    LOG_INFO(Render_Vulkan, "Physical device subgroup size {}", vk11_props.subgroupSize);
+    LOG_INFO(Render_Vulkan, "Physical device subgroup size {} min={} max={} requiredStages={:#x}",
+             vk11_props.subgroupSize, vk13_props.minSubgroupSize, vk13_props.maxSubgroupSize,
+             static_cast<u32>(vk13_props.requiredSubgroupSizeStages));
 
     if (available_extensions.empty()) {
         LOG_CRITICAL(Render_Vulkan, "No extensions supported by device.");
diff --git a/src/video_core/texture_cache/texture_cache.cpp b/src/video_core/texture_cache/texture_cache.cpp
index f14c73b4..55171dee 100644
--- a/src/video_core/texture_cache/texture_cache.cpp
+++ b/src/video_core/texture_cache/texture_cache.cpp
@@ -1,3 +1,4 @@
+#include <cstdlib>
 // SPDX-FileCopyrightText: Copyright 2024-2026 shadPS4 Emulator Project
 // SPDX-License-Identifier: GPL-2.0-or-later
 
@@ -791,6 +792,18 @@ ImageView& TextureCache::FindTexture(ImageId image_id, const ImageDesc& desc) {
 
 ImageView& TextureCache::FindRenderTarget(ImageId image_id, const ImageDesc& desc) {
     Image& image = slot_images[image_id];
+    static const bool nba_target_diag = std::getenv("NBA2K14_SCANOUT_DIAG") != nullptr;
+    static unsigned nba_target_count{};
+    if (nba_target_diag && (desc.info.guest_address == 0xaf48000 ||
+                            desc.info.guest_address == 0xb748000) &&
+        ++nba_target_count % 600 == 0) {
+        LOG_INFO(Render_Vulkan,
+                 "NBA2K14_TARGET addr={:#x} request={}x{} pitch={} tile={} samples={} backing={}x{} pitch={} tile={} samples={}",
+                 desc.info.guest_address, desc.info.size.width, desc.info.size.height,
+                 desc.info.pitch, static_cast<u32>(desc.info.tile_mode), desc.info.num_samples,
+                 image.info.size.width, image.info.size.height, image.info.pitch,
+                 static_cast<u32>(image.info.tile_mode), image.info.num_samples);
+    }
     image.flags |= ImageFlagBits::GpuModified;
     if (readback_linear_images && !image.info.props.is_tiled) {
         download_images.emplace(image_id);
diff --git a/src/video_core/texture_cache/tile_manager.cpp b/src/video_core/texture_cache/tile_manager.cpp
index b5f9c9d4..a4b1e8fe 100644
--- a/src/video_core/texture_cache/tile_manager.cpp
+++ b/src/video_core/texture_cache/tile_manager.cpp
@@ -18,6 +18,7 @@
 
 #include <algorithm>
 #include <chrono>
+#include <cstdlib>
 #include <limits>
 // std::count_if used in AcquireScratchSlot claim()
 
@@ -480,6 +481,13 @@ vk::Pipeline TileManager::GetTilingPipeline(const ImageInfo& info, bool is_tiler
         return pipeline;
     }
 
+    static const bool nba_tile_diag = std::getenv("NBA2K14_SCANOUT_DIAG") != nullptr;
+    if (nba_tile_diag) {
+        LOG_INFO(Render_Vulkan, "NBA2K14_TILE_PIPELINE tile={} bpp={} samples={} extent={}x{} pitch={} levels={} block={}",
+                 static_cast<u32>(info.tile_mode), info.num_bits, info.num_samples,
+                 info.size.width, info.size.height, info.pitch, info.resources.levels,
+                 info.props.is_block);
+    }
     const auto device = instance.GetDevice();
     const auto micro_tile_mode = AmdGpu::GetMicroTileMode(info.tile_mode);
     std::vector<std::string> defines = {
@@ -542,6 +550,14 @@ TileManager::Result TileManager::DetileImage(vk::Buffer in_buffer, u32 in_offset
         return {in_buffer, in_offset};
     }
 
+    static const bool nba_alignment_diag = std::getenv("NBA2K14_SCANOUT_DIAG") != nullptr;
+    static unsigned nba_alignment_count{};
+    if (nba_alignment_diag && (++nba_alignment_count <= 8 ||
+                              in_offset % instance.StorageMinAlignment() != 0)) {
+        LOG_INFO(Render_Vulkan, "NBA2K14_DETILE_ALIGNMENT offset={} storage_min={} valid={}",
+                 in_offset, instance.StorageMinAlignment(),
+                 in_offset % instance.StorageMinAlignment() == 0);
+    }
     TilingInfo params{};
     params.bank_swizzle = info.bank_swizzle;
     params.num_slices = info.props.is_volume ? info.size.depth : info.resources.layers;

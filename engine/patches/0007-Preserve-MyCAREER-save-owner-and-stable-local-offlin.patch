+#ifdef ENABLE_NBA_2K14_COMPATIBILITY
+    // Fixed-VA save-owner and NULLGUARD edits are known only for CUSA00104 v01.00.
+    // Check mapped file-backed executable ranges before reading any expected bytes.
+    const bool is_supported_offline_eboot = is_nba_2k14_eboot && map_fixed_address &&
+        Common::ElfInfo::Instance().GameSerial() == "CUSA00104" &&
+        Common::ElfInfo::Instance().AppVer() == "01.00";
+    const auto contains_code = [&](u64 address, size_t size) {
+        for (const auto& ph : elf_pheader) {
+            if ((ph.p_type == PT_LOAD || ph.p_type == PT_SCE_RELRO) &&
+                (ph.p_flags & PF_EXEC) != 0 && address >= ph.p_vaddr &&
+                size <= ph.p_filesz && address - ph.p_vaddr <= ph.p_filesz - size) {
+                return true;
+            }
+        }
+        return false;
+    };
+    if (is_supported_offline_eboot) {
+        // OnNewUser otherwise copies an empty offline login slot into the save owner.
+        constexpr u64 owner_va = 0xe6f8e4;
+        constexpr std::array<u8, 5> expected{0x4a, 0x8b, 0x44, 0x38, 0x40};
+        constexpr std::array<u8, 5> replacement{0xb8, 0x01, 0x00, 0x00, 0x00};
+        if (contains_code(owner_va, expected.size()) &&
+            std::memcmp(reinterpret_cast<const void*>(owner_va), expected.data(), expected.size()) == 0) {
+            ASSERT_MSG(WriteNba2K14CompatibilityBytes(owner_va, replacement),
+                       "NBA2K14: could not write save-owner patch");
+            LOG_INFO(Core_Linker, "NBA2K14: applied save-owner patch at {:#x}", owner_va);
+        } else {
+            LOG_ERROR(Core_Linker, "NBA2K14: save-owner patch site mismatch; not patching");
+        }
+    }
+#endif

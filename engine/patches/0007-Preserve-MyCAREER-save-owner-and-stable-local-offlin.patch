+            const std::string local = GetLocalHandle(user.user_id);
+            if (!local.empty() && local.substr(0, sizeof(online_id->data) - 1) == requested) {
+                *account_id = StableLocalAccountId(local);
+                return ORBIS_OK;
+            }
+        }
         *account_id = 0;
         return ORBIS_NP_ERROR_SIGNED_OUT;
     }

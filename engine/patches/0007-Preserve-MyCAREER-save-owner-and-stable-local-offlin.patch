+// Local offline identity: cached profile identity, without network reachability or authentication.
+static std::string GetLocalHandle(Libraries::UserService::OrbisUserServiceUserId user_id) {
+#ifdef ENABLE_NBA_2K14_COMPATIBILITY
+    if (Core::Nba2K14Compatibility::IsTitle(Common::ElfInfo::Instance().Title())) {
+        if (const User* user = UserManagement.GetUserByID(user_id)) {
+            return user->shadnet_npid.empty() ? user->user_name : user->shadnet_npid;
+        }
+    }
+#endif
+    return {};
+}
+
+static u64 StableLocalAccountId(std::string_view handle) {
+    // Preserve the PC save-fix hash and seed for a run-stable, non-zero owner.
+    u64 hash = 1469598103934665603ULL;
+    for (const unsigned char c : handle) {
+        hash ^= c;
+        hash *= 1099511628211ULL;
+    }
+    return hash | 0x8000000000000000ULL;
+}

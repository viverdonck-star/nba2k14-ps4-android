From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: NBA2K14-offline-port <nba2k14-offline@localhost>
Date: Fri, 30 Oct 2026 22:19:13 +0100
Subject: [PATCH 14/40] Allow Termux launcher to confirm NBA title screen until
 startup progresses

---
 src/core/libraries/pad/pad.cpp | 35 ++++++++++++++++++++++++++++++++++
 1 file changed, 35 insertions(+)

diff --git a/src/core/libraries/pad/pad.cpp b/src/core/libraries/pad/pad.cpp
index 8f30ca99..383cef26 100644
--- a/src/core/libraries/pad/pad.cpp
+++ b/src/core/libraries/pad/pad.cpp
@@ -13,6 +13,8 @@
 #include "pad.h"
 
 #include <algorithm>
+#include <chrono>
+#include <cstdlib>
 #include <optional>
 
 namespace Libraries::Pad {
@@ -590,6 +592,39 @@ int PS4_SYSV_ABI scePadReadState(s32 handle, OrbisPadData* pData) {
     Input::State state;
     controller.ReadState(&state, &connected, &connected_count);
     ProcessStates(handle, pData, controller, &state, 1, connected, connected_count);
+#ifdef ENABLE_NBA_2K14_COMPATIBILITY
+    // Termux's glibc SDL backend may not receive the Odin's Android gamepad input.
+    // The title screen still waits for a confirm press, even if its image is black.
+    // Opt-in launcher workaround: stop injecting as soon as startup progresses.
+    static const bool auto_start = [] {
+        const char* value = std::getenv("NBA2K14_AUTO_START");
+        return value && value[0] == '1';
+    }();
+    static const auto first_read = std::chrono::steady_clock::now();
+    static bool startup_finished = false;
+    static long last_logged_pulse = -1;
+    if (auto_start && !startup_finished &&
+        Common::ElfInfo::Instance().GameSerial() == "CUSA00104" &&
+        Common::ElfInfo::Instance().AppVer() == "01.00") {
+        const auto elapsed = std::chrono::duration_cast<std::chrono::milliseconds>(
+            std::chrono::steady_clock::now() - first_read).count();
+        const u32 login_state = *reinterpret_cast<volatile const u32*>(0x1c2a254);
+        const u32 trophy_state = *reinterpret_cast<volatile const u32*>(0x1c99778);
+        const u32 trophy_flags = *reinterpret_cast<volatile const u32*>(0x1c99780);
+        if (login_state != 0 || trophy_state != 0 || (trophy_flags & 8) != 0) {
+            startup_finished = true;
+            LOG_INFO(Lib_Pad, "NBA2K14_AUTO_START finished; normal controller input restored");
+        } else if (elapsed >= 30000 && elapsed < 90000 &&
+                   (trophy_flags & 3) == 3 && elapsed % 10000 < 500) {
+            pData->buttons |= OrbisPadButtonDataOffset::Cross | OrbisPadButtonDataOffset::Options;
+            const long pulse = elapsed / 10000;
+            if (last_logged_pulse != pulse) {
+                last_logged_pulse = pulse;
+                LOG_INFO(Lib_Pad, "NBA2K14_AUTO_START confirm at {} ms", elapsed);
+            }
+        }
+    }
+#endif
     return ORBIS_OK;
 }
 

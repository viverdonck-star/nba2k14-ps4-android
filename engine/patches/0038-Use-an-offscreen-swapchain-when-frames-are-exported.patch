From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: NBA2K14 Android port <nba2k14-android@users.noreply.github.com>
Date: Wed, 25 Nov 2026 18:54:48 +0100
Subject: [PATCH 38/40] Use an offscreen swapchain when frames are exported

With NBA2K14_FRAME_SOCKET the driver's headless WSI crashes (bus error
in swapchain creation), so the swapchain keeps
its interface but owns three plain images: no WSI, no semaphores,
Present does nothing.
---
 .../renderer_vulkan/vk_presenter.cpp          |  9 ++-
 .../renderer_vulkan/vk_swapchain.cpp          | 81 ++++++++++++++++++-
 src/video_core/renderer_vulkan/vk_swapchain.h |  3 +
 3 files changed, 89 insertions(+), 4 deletions(-)

diff --git a/src/video_core/renderer_vulkan/vk_presenter.cpp b/src/video_core/renderer_vulkan/vk_presenter.cpp
index cd8258fb..641fa2d9 100644
--- a/src/video_core/renderer_vulkan/vk_presenter.cpp
+++ b/src/video_core/renderer_vulkan/vk_presenter.cpp
@@ -1193,9 +1193,14 @@ void Presenter::Present(Frame* frame, bool is_reusing_frame) {
     }
 
     SubmitInfo info{};
-    info.AddWait(swapchain.GetImageAcquiredSemaphore());
+    const bool uses_wsi = !FrameExport::Get().Enabled();
+    if (uses_wsi) {
+        info.AddWait(swapchain.GetImageAcquiredSemaphore());
+    }
     info.AddWait(frame->ready_semaphore, frame->ready_tick);
-    info.AddSignal(swapchain.GetPresentReadySemaphore());
+    if (uses_wsi) {
+        info.AddSignal(swapchain.GetPresentReadySemaphore());
+    }
     info.AddSignal(frame->present_done);
     scheduler.Flush(info);
     if (trace) {

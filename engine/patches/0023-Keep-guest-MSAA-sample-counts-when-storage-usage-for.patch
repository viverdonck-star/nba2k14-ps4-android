From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: NBA2K14 Android port <nba2k14-android@users.noreply.github.com>
Date: Wed, 25 Nov 2026 18:54:48 +0100
Subject: [PATCH 23/40] Keep guest MSAA sample counts when storage usage
 forbids them

Turnip has no shaderStorageImageMultisample: with the storage usage
every image offers 1 sample only,
so the guest's 4x render targets became 1x images read through
sampler2DMS, which scrambles the frame.
Drop the storage usage on multisampled images when it is what forbids
the guest's sample count.
---
 src/video_core/renderer_vulkan/liverpool_to_vk.h |  2 ++
 src/video_core/texture_cache/image.cpp           | 15 ++++++++++++++-
 2 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/src/video_core/renderer_vulkan/liverpool_to_vk.h b/src/video_core/renderer_vulkan/liverpool_to_vk.h
index 2ca737ac..d108b8d1 100644
--- a/src/video_core/renderer_vulkan/liverpool_to_vk.h
+++ b/src/video_core/renderer_vulkan/liverpool_to_vk.h
@@ -76,6 +76,8 @@ vk::Format DepthFormat(AmdGpu::DepthBuffer::ZFormat z_format,
 
 vk::ClearValue ColorBufferClearValue(const AmdGpu::ColorBuffer& color_buffer);
 
+vk::SampleCountFlagBits RawNumSamples(u32 num_samples);
+
 vk::SampleCountFlagBits NumSamples(u32 num_samples, vk::SampleCountFlags supported_flags);
 
 static inline bool IsFormatDepthCompatible(vk::Format fmt) {
diff --git a/src/video_core/texture_cache/image.cpp b/src/video_core/texture_cache/image.cpp
index a227c5d8..0037ea7d 100644
--- a/src/video_core/texture_cache/image.cpp
+++ b/src/video_core/texture_cache/image.cpp
@@ -161,8 +161,21 @@ Image::Image(const Vulkan::Instance& instance_, Vulkan::Scheduler& scheduler_,
         .usage = usage_flags,
         .flags = flags,
     };
-    const auto image_format_properties =
+    auto image_format_properties =
         instance->GetPhysicalDevice().getImageFormatProperties2(format_info);
+    // Without shaderStorageImageMultisample the storage usage limits the image to one sample.
+    // Dropping it keeps the guest sample count, which shaders reading the image rely on.
+    if (info.num_samples > 1 && (usage_flags & vk::ImageUsageFlagBits::eStorage) &&
+        image_format_properties.result == vk::Result::eSuccess &&
+        !(image_format_properties.value.imageFormatProperties.sampleCounts &
+          LiverpoolToVK::RawNumSamples(info.num_samples))) {
+        usage_flags &= ~vk::ImageUsageFlagBits::eStorage;
+        format_features = FormatFeatureFlags(usage_flags);
+        auto no_storage_info = format_info;
+        no_storage_info.usage = usage_flags;
+        image_format_properties =
+            instance->GetPhysicalDevice().getImageFormatProperties2(no_storage_info);
+    }
     if (image_format_properties.result == vk::Result::eErrorFormatNotSupported) {
         LOG_ERROR(Render_Vulkan, "image format {} type {} is not supported (flags {}, usage {})",
                   vk::to_string(supported_format), vk::to_string(format_info.type),
